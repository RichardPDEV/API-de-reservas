# Example production environment variables
# Copy this to .env.prod and set real secrets before deploying

# Database connection (JDBC URL)
DB_URL=jdbc:postgresql://DB_HOST:5432/reservas
DB_USERNAME=reservas
DB_PASSWORD=changeme_secure_password

# Application JWT secret (set to a long, random value)
APP_JWT_SECRET=replace_with_long_random_secret

# Cookie / auth settings (optional)
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=None

# Mail settings (adjust for your provider)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=reservas@example.com

# Spring profile
SPRING_PROFILES_ACTIVE=prod
