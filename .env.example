# Copia este archivo a ".env" y ajusta los valores.
#
# IMPORTANTE:
# - Docker Compose usa el perfil por defecto (desarrollo local).
# - Producción real exige SPRING_PROFILES_ACTIVE=prod y las variables marcadas como OBLIGATORIAS.

# ---------------------------------------------------------------------------
# Desarrollo local / Docker Compose (perfil por defecto, sin SPRING_PROFILES_ACTIVE=prod)
# ---------------------------------------------------------------------------

PORT=8080

DB_URL=jdbc:postgresql://postgres:5432/reservas
DB_USERNAME=reservas
DB_PASSWORD=reservas

APP_JWT_SECRET=dev-only-insecure-jwt-secret-do-not-use-in-prod!!
APP_JWT_ACCESS_VALIDITY_MS=900000
APP_JWT_REFRESH_VALIDITY_MS=604800000

APP_CORS_ALLOWED_ORIGINS=http://localhost:8089,http://localhost:5173
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=Lax

MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-resend-api-key
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=reservas@example.com

# ---------------------------------------------------------------------------
# Producción real (SPRING_PROFILES_ACTIVE=prod) — OBLIGATORIAS
# ---------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod
#
# DB_URL=jdbc:postgresql://tu-host:5432/reservas
# DB_USERNAME=reservas
# DB_PASSWORD=<contraseña-segura-unica>
# APP_JWT_SECRET=<cadena-aleatoria-de-al-menos-32-caracteres>
#
# HTTPS / CORS / cookies (obligatorias en prod; la app no arranca sin ellas):
# APP_CORS_ALLOWED_ORIGINS=https://reservas.tu-dominio.com
# APP_COOKIE_SECURE=true
# APP_COOKIE_SAMESITE=None
#   (None + Secure=true si frontend y API están en subdominios distintos)
#
# Correo (obligatorio en prod; la app no arranca sin credenciales reales):
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=<tu-api-key-resend>
# MAIL_FROM=reservas@tu-dominio.com
#
# Opcional:
# APP_COOKIE_DOMAIN=.tu-dominio.com
# SENTRY_DSN=
