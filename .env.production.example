# Production environment example for the Spring Boot API
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# JWT
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_JWT_REFRESH_VALIDITY_MS=604800000

# Database
DB_URL=jdbc:postgresql://YOUR_DB_HOST:5432/reservas
DB_USERNAME=reservas
DB_PASSWORD=change-me

# Mail
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=reservas@your-domain.com

# Auth / cookies
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=None
APP_COOKIE_DOMAIN=.your-domain.com

# CORS (frontend origin(s))
APP_CORS_ALLOWED_ORIGINS=https://reservas.your-domain.com,https://www.reservas.your-domain.com
